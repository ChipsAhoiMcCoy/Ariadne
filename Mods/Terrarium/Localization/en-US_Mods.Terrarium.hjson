Keybinds: {
	OpenScanner.DisplayName: Open Scanner
	ToggleWallTones.DisplayName: Toggle Wall Tones
	AimUp.DisplayName: Aim Up
	AimLeft.DisplayName: Aim Left
	AimDown.DisplayName: Aim Down
	AimRight.DisplayName: Aim Right
	UseHeldItem.DisplayName: Use Held Item
	SecondaryUse.DisplayName: Secondary Use or Interact
	CombatTargetModifier.DisplayName: Combat Target Modifier
}

Announcements: {
	WallTonesOn: Wall tones on
	WallTonesOff: Wall tones off
	SmartCursor: Smart cursor
	UnlockedCursor: Unlocked cursor
}

Configs: {
	TerrariumClientConfig: {
		DisplayName: Terrarium Accessibility Settings

		BiomeAnnouncementsEnabled: {
			Label: Biome announcements
			Tooltip: Announce a biome after the player has remained in it long enough to avoid rapid announcements at biome boundaries.
		}

		WallToneEnabled: {
			Label: Wall tones
			Tooltip: Continuously indicate nearby left walls, right walls, and the gravity-relative ceiling with procedural audio.
		}

		WallToneVolumePercent: {
			Label: Wall tone volume
			Tooltip: Set wall-tone loudness as a percentage of the game's Sound volume.
		}

		WallToneRangeTiles: {
			Label: Wall tone range
			Tooltip: Set the maximum sensing distance in tiles. A larger range begins indicating terrain sooner.
		}

		WallToneSpatialization: {
			Label: Wall tone spatialization
			Tooltip: Binaural adds a small far-ear timing difference. Stereo pan retains only ear-level differences for devices where timing cues are unsuitable.
		}

		WallToneItdMilliseconds: {
			Label: ITD amount
			Tooltip: Set the maximum interaural time difference in milliseconds. This applies only in Binaural mode; Stereo pan always uses zero delay.
		}

		HostileMobTonesEnabled: {
			Label: Hostile mob proximity tones
			Tooltip: Play continuous modulated square tones for a prioritized set of hostile NPCs whose hitboxes are currently on screen. Tones become louder and more rapidly modulated as an enemy approaches, while screen height alone controls pitch.
		}

		HostileMobToneVolumePercent: {
			Label: Hostile and target cue volume
			Tooltip: Set hostile-mob tone and combat-target lock cue loudness as a percentage of the game's Sound volume.
		}

		HostileMobMaximumEmitters: {
			Label: Maximum hostile mob emitters
			Tooltip: Set how many on-screen enemies can emit continuous proximity tones at once. Bosses have priority, followed by enemies nearest the player.
		}

		HostileMobToneSpatialization: {
			Label: Hostile and target cue spatialization
			Tooltip: Control spatialization for hostile-mob tones and combat-target lock cues. Binaural adds a small far-ear timing difference. Stereo pan retains only ear-level differences for devices where timing cues are unsuitable.
		}

		HostileMobToneItdMilliseconds: {
			Label: Hostile and target cue ITD amount
			Tooltip: Set the maximum hostile-tone and combat-target cue interaural time difference in milliseconds. The full amount occurs at either screen edge in Binaural mode; Stereo pan always uses zero delay.
		}
	}

	WallToneSpatializationMode: {
		Tooltip: ""

		Binaural: {
			Label: Binaural
			Tooltip: ""
		}

		StereoPan: {
			Label: Stereo pan
			Tooltip: ""
		}
	}
}
