Menus: {
	ManageMods: {
		ReloadPending: Enabled mod changes are saved and still require a mod reload.
		DisableTitle: Disable Ariadne and reload?
		DisableWarning: Reloading with Ariadne disabled stops its speech and accessibility support. Speech cannot recover until Ariadne is enabled and mods are reloaded again.
		ReloadTitle: Applying Mod Changes
		ReloadAnnouncement: Reloading mods. Speech will pause and recover automatically.
	}
}

