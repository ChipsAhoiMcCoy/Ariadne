<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ariadne.TestBenches.SpatialAudio</RootNamespace>
    <AssemblyName>SpatialAudioHarness</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Matches the mod's framework so the linked sources compile identically, but
         runs on whatever runtime this machine actually has. -->
    <RollForward>LatestMajor</RollForward>

    <_TmlPath Condition="'$(TML_INSTALL_PATH)' != ''">$(TML_INSTALL_PATH)</_TmlPath>
    <_TmlPath Condition="'$(_TmlPath)' == '' and '$(tMLSteamPath)' != ''">$(tMLSteamPath)</_TmlPath>
    <_TmlPath Condition="'$(_TmlPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\tModLoader</_TmlPath>
    <_ModRoot>$(MSBuildThisFileDirectory)..\..\Mods\Ariadne</_ModRoot>
  </PropertyGroup>

  <!-- The real mixer sources, compiled as-is. Copying the maths into the harness
       would only test the copy, so the files under test are linked instead. -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="TerrariaShim.cs" />
    <Compile Include="$(_ModRoot)\Audio\AudioFormat.cs" Link="Linked\AudioFormat.cs" />
    <Compile Include="$(_ModRoot)\Audio\AudioInterpolation.cs" Link="Linked\AudioInterpolation.cs" />
    <Compile Include="$(_ModRoot)\Audio\AudioLoudness.cs" Link="Linked\AudioLoudness.cs" />
    <Compile Include="$(_ModRoot)\Audio\AuthoredAudioLevels.cs" Link="Linked\AuthoredAudioLevels.cs" />
    <Compile Include="$(_ModRoot)\Audio\SpatialAudioMixer.cs" Link="Linked\SpatialAudioMixer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FNA">
      <HintPath>$(_TmlPath)\Libraries\FNA\1.0.0\FNA.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- FAudio is what AudioFormat asks for the endpoint rate, so the harness needs
       the same native library the game loads for that query to be real. -->
  <ItemGroup>
    <None Include="$(_TmlPath)\Libraries\Native\Windows\FAudio.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(_TmlPath)\Libraries\Native\Windows\SDL2.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
